{
  "team_id": "public-actions-runner-host",
  "repository": "GlacierEQ/public-actions-runner-host",
  "visibility": "public",
  "execution_mode": "github-hosted",
  "runner_policy": {
    "allowed_runner_prefixes": ["ubuntu-", "windows-", "macos-"],
    "preferred_runner": "ubuntu-latest",
    "self_hosted_allowed": false,
    "private_runner_references_allowed": false
  },
  "consumer_policy": {
    "preferred_entrypoints": [
      "GlacierEQ/public-actions-runner-host/.github/workflows/reusable-ci.yml@main",
      "GlacierEQ/public-actions-runner-host/.github/workflows/reusable-quick-ci.yml@main",
      "GlacierEQ/public-actions-runner-host/.github/workflows/reusable-shared.yml@main"
    ],
    "private_control_plane_workflows_allowed": false
  },
  "purpose": "Repository-based public execution boundary. This is not an organization self-hosted runner group."
}
