{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GlacierEQ/public-actions-runner-host/config/job-envelope.schema.json",
  "title": "APEX Public Job Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id"],
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"
    },
    "pillar": {
      "type": "string",
      "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I"]
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "source_repo": {
      "type": "string",
      "pattern": "^GlacierEQ/[A-Za-z0-9_.-]+$",
      "maxLength": 128
    },
    "source_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "task": {
      "type": "string",
      "enum": ["validate", "hash-manifest", "test", "build", "audit"]
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"
    }
  },
  "allOf": [
    {
      "if": {"required": ["action"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["source_repo"]},
            {"required": ["task"]}
          ]
        }
      }
    },
    {
      "if": {"not": {"required": ["action"]}},
      "then": {"required": ["pillar", "source_repo", "task"]}
    }
  ]
}
