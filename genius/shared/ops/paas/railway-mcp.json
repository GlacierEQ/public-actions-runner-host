{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "buildTarget": "mcp"
  },
  "deploy": {
    "startCommand": "python remote_mcp_server.py",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "preDeployCommand": "python genius/pro-code/smithery_control_plane/runtime/bootstrap_check.py"
  },
  "environments": {
    "production": {
      "PORT": "8001",
      "MCP_MODE": "remote",
      "MCP_TRANSPORT": "streamable_http"
    }
  }
}
