{
  "mcpServers": {
    "fileboss-remote": {
      "url": "https://fileboss-mcp.up.railway.app/mcp",
      "transport": "http",
      "description": "FILEBOSS Remote MCP — Streamable HTTP (MCP 2025-03-26)",
      "auth": {
        "type": "bearer",
        "token": "${FILEBOSS_MCP_TOKEN}"
      }
    },
    "fileboss-local": {
      "command": "python",
      "args": [
        "-m",
        "smithery_control_plane.runtime.launch_local"
      ],
      "env": {
        "ASPEN_GROVE_BASE_URL": "http://localhost:7000"
      },
      "description": "FILEBOSS local stdio MCP with process-local AKOS bootstrap"
    },
    "memory-plugin-a": {
      "url": "https://memory.mcp.so/mcp",
      "transport": "http",
      "auth": {
        "type": "bearer",
        "token": "${MEMORY_PLUGIN_TOKEN_A}"
      }
    },
    "memory-plugin-b": {
      "url": "https://memory.mcp.so/mcp",
      "transport": "http",
      "auth": {
        "type": "bearer",
        "token": "${MEMORY_PLUGIN_TOKEN_B}"
      }
    }
  }
}
