{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.dev/schemas/code/fileboss-operator-code-job-v1.json",
  "title": "FILEBOSS Operator Code Validation Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "pillar", "action", "adapter", "task", "source_repo", "source_ref", "target_repo"],
  "properties": {
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"},
    "pillar": {"const": "C"},
    "action": {"const": "code.fileboss.validate-operator-code-bridge"},
    "adapter": {"const": "fileboss-operator-code-validate"},
    "task": {"const": "test"},
    "source_repo": {"const": "GlacierEQ/FILEBOSS"},
    "source_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_repo": {"const": "GlacierEQ/FILEBOSS"}
  }
}
