{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.dev/schemas/code/monolith-company-registry-job-v1.json",
  "title": "Monolith Company Registry Validation Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "domain", "action", "source_ref"],
  "properties": {
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"},
    "domain": {"const": "code"},
    "action": {"const": "code.monolith.validate-company-engineered-registry"},
    "source_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approval_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"}
  }
}
