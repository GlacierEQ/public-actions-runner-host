{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.dev/schemas/code/monolith-atlases-result-v1.json",
  "title": "Monolith Atlas Validation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "pillar",
    "action",
    "adapter",
    "task",
    "source_repo",
    "source_ref",
    "resolved_source_sha",
    "target_repo",
    "provenance",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"},
    "pillar": {"const": "C"},
    "action": {"const": "code.monolith.validate-atlases"},
    "adapter": {"const": "test"},
    "task": {"const": "test"},
    "source_repo": {"const": "GlacierEQ/monolith"},
    "source_ref": {"type": "string", "maxLength": 128},
    "resolved_source_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40})?$"},
    "target_repo": {"const": "GlacierEQ/monolith"},
    "provenance": {"type": "object"},
    "status": {"enum": ["completed", "failed", "blocked"]},
    "steps": {"type": "array", "maxItems": 22},
    "command_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validated_gates": {
      "type": "array",
      "maxItems": 7,
      "items": {"type": "string", "maxLength": 64}
    },
    "workspace_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {"$ref": "#/$defs/workspaceAttestation"},
        "after": {
          "anyOf": [
            {"$ref": "#/$defs/workspaceAttestation"},
            {"type": "null"}
          ]
        }
      }
    },
    "projection_repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "generator",
        "resolved_source_sha",
        "fact_card_count",
        "total_bytes",
        "files"
      ],
      "properties": {
        "status": {"const": "available"},
        "generator": {"const": "scripts/build_monolith_command_atlas.py"},
        "resolved_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "fact_card_count": {"type": "integer", "minimum": 1, "maximum": 256},
        "total_bytes": {"type": "integer", "minimum": 1, "maximum": 500000},
        "files": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256", "content"],
            "properties": {
              "path": {
                "enum": [
                  "catalog/monolith_command_atlas.json",
                  "status/MONOLITH_COMMAND_ATLAS.md"
                ]
              },
              "bytes": {"type": "integer", "minimum": 1, "maximum": 250000},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "content": {"type": "string", "maxLength": 250000}
            }
          }
        }
      }
    },
    "reason": {"type": "string", "maxLength": 2048}
  },
  "$defs": {
    "workspaceAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolved_source_sha",
        "tracked_clean",
        "tracked_diff_sha256",
        "checkout_device",
        "checkout_inode"
      ],
      "properties": {
        "resolved_source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tracked_clean": {"const": true},
        "tracked_diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checkout_device": {"type": "integer", "minimum": 0},
        "checkout_inode": {"type": "integer", "minimum": 1}
      }
    }
  }
}
