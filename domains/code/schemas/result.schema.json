{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.dev/schemas/code/governance-result-v1.json",
  "title": "Code Governance Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "domain",
    "action",
    "adapter",
    "adapter_sha256",
    "token_profile",
    "source_repo",
    "source_ref",
    "expected_source_sha",
    "approval_id",
    "resolved_source_sha",
    "status",
    "checks",
    "artifact_references",
    "legacy_result_sha256",
    "test_count",
    "manifest_summary",
    "secret_scan",
    "parent_receipt_sha256",
    "reason",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"
    },
    "domain": {
      "const": "code"
    },
    "action": {
      "const": "code.validate-governance"
    },
    "adapter": {
      "const": "monolith_ip_governance"
    },
    "adapter_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "token_profile": {
      "const": "private-source-read"
    },
    "source_repo": {
      "const": "GlacierEQ/monolith"
    },
    "source_ref": {
      "type": "string",
      "maxLength": 128
    },
    "expected_source_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"
    },
    "resolved_source_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40})?$"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "output_sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "blocked"
            ]
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "artifact_references": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "secret-scan-report",
              "publication-receipt"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "legacy_result_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "test_count": {
      "type": "integer",
      "minimum": 0
    },
    "manifest_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "visibility": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "rights_status": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "publication_class": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "release_status": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "ai_assistance": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "human_review_status": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        }
      }
    },
    "secret_scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scanner": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "scanned_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "files_tracked": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "files_scanned": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "files_skipped": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "finding_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "report_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "parent_receipt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason": {
      "type": "string",
      "maxLength": 2048
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
