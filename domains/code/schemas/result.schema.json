{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.dev/schemas/code/governance-result-v1.json",
  "title": "Code Governance Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "domain",
    "action",
    "adapter",
    "adapter_sha256",
    "token_profile",
    "source_repo",
    "source_ref",
    "resolved_source_sha",
    "status",
    "checks",
    "artifact_references",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"
    },
    "domain": {
      "const": "code"
    },
    "action": {
      "const": "code.validate-governance"
    },
    "adapter": {
      "const": "monolith_ip_governance"
    },
    "adapter_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "token_profile": {
      "const": "private-source-read"
    },
    "source_repo": {
      "const": "GlacierEQ/monolith"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "resolved_source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "output_sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "blocked"
            ]
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "artifact_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "parent_receipt_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
