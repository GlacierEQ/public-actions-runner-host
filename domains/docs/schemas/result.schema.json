{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.dev/schemas/docs/monolith-docs-result-v1.json",
  "title": "Monolith Documentation Integrity Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "pillar",
    "action",
    "adapter",
    "task",
    "source_repo",
    "source_ref",
    "resolved_source_sha",
    "target_repo",
    "provenance",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "job_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"},
    "pillar": {"const": "B"},
    "action": {"const": "docs.monolith.validate-integrity"},
    "adapter": {"const": "validate"},
    "task": {"const": "validate"},
    "source_repo": {"const": "GlacierEQ/monolith"},
    "source_ref": {"type": "string", "maxLength": 128},
    "resolved_source_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40})?$"},
    "target_repo": {"const": "GlacierEQ/monolith"},
    "provenance": {"type": "object"},
    "status": {"enum": ["completed", "failed", "blocked"]},
    "docs_summary": {"type": "object"},
    "invalid_json": {"type": "array", "maxItems": 50},
    "broken_links": {"type": "array", "maxItems": 50},
    "unbalanced_fences": {"type": "array", "maxItems": 50},
    "reason": {"type": "string", "maxLength": 2048}
  }
}
