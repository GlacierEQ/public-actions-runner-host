{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaciereq.dev/schemas/docs/monolith-docs-job-v1.json",
  "title": "Monolith Documentation Integrity Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "domain", "action", "source_ref"],
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"
    },
    "domain": {"const": "docs"},
    "action": {"const": "docs.monolith.validate-integrity"},
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!/)(?!.*(?:\\.\\.|//|@\\{|\\\\))[A-Za-z0-9._/-]+$",
      "not": {"pattern": "(?:/$|\\.lock$)"}
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,63}$"
    }
  }
}
