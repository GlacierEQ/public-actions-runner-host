{
  "schema_version": "1.0",
  "domain": "docs",
  "actions": {
    "docs.monolith.validate-integrity": {
      "status": "active",
      "adapter": "validate",
      "adapterPath": "domains/docs/adapters/monolith_docs_validate.py",
      "targetRepository": "GlacierEQ/monolith",
      "tokenProfile": "private-source-read",
      "jobSchema": "monolith-docs-job-v1",
      "resultSchema": "monolith-docs-result-v1",
      "approvalPolicy": "owner-dispatched",
      "executionMode": "source-read-only",
      "receiptNamespace": "docs",
      "concurrencyKeyTemplate": "docs:{targetRepository}",
      "legacyAliases": [
        "monolith-docs-integrity"
      ]
    }
  },
  "plannedActions": [
    "docs.render",
    "docs.package",
    "docs.convert"
  ]
}
